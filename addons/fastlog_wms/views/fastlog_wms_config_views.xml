<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fastlog_wms_config_tree" model="ir.ui.view">
        <field name="name">fastlog.wms.config.tree</field>
        <field name="model">fastlog.wms.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_fastlog_wms_config_form" model="ir.ui.view">
        <field name="name">fastlog.wms.config.form</field>
        <field name="model">fastlog.wms.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="warehouse_id"/>
                        <field name="active"/>
                    </group>
                    <group string="Notizen">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fastlog_wms_config" model="ir.actions.act_window">
        <field name="name">Fastlog-WMS Konfiguration</field>
        <field name="res_model">fastlog.wms.config</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
